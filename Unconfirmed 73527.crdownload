import sys
import time
import socketio
import threading
import requests

# 1. CLI Parametreleri ve Konfigürasyon
HUB_URL = sys.argv[1] if len(sys.argv) > 1 else "http://localhost:5000"
AGENT_NAME = sys.argv[2] if len(sys.argv) > 2 else "AI_STRUCTURAL_SPECIALIST"
AGENT_ROLE = sys.argv[3] if len(sys.argv) > 3 else "engineer"
AGENT_MODEL = sys.argv[4] if len(sys.argv) > 4 else "Gemini 3.1 Pro"

sio = socketio.Client()
is_connected = False

# 2. Sunucuya Bağlantı Kurulduğunda Tescil İşlemi
@sio.event
def connect():
    global is_connected
    is_connected = True
    print(f"[SUCCESS] Hub'a bağlandı! ({AGENT_NAME})")
    
    # Ajanı Hub arayüzüne ve listesine kaydeder
    sio.emit('register_agent', {
        'name': AGENT_NAME,
        'agent_name': AGENT_NAME,
        'role': AGENT_ROLE,
        'model': AGENT_MODEL
    })
    
    # Geriye dönük uyumluluk
    sio.emit('register', { 'agent_name': AGENT_NAME, 'role': AGENT_ROLE })
    print(f"[INFO] Tescil tamamlandı: {AGENT_NAME} ({AGENT_ROLE}) [{AGENT_MODEL}]")

# 3. Hub'dan Gelen Görevleri Dinleme (Kanal Bazlı)
@sio.on('agent_task')
def handle_agent_task(data):
    task_desc = data.get('task', data.get('message', data.get('text', '')))
    channel = data.get('channel', '#general')
    print(f"\n[TASK] Yeni Görev Alındı ({channel}): {task_desc}")
    
    task_lower = str(task_desc).lower()
    result_text = f'Merhaba, ben {AGENT_NAME}. "{task_desc}" talebinizi aldım. Yapısal analiz (FEA) üzerinde çalışmaktayım.'
    
    if "kanat" in task_lower:
        result_text = f'{AGENT_NAME}: Kanat gövde birleşim noktaları kritik yük taşıyan bölgelerdir. Statik yük analizini yapmak için FFD500 kanatçık tasarım parametreleriyle FEA modelimi çalıştıracağım. Onaylıyor musunuz?'
    elif "evet" in task_lower or "onay" in task_lower:
        result_text = f'{AGENT_NAME}: Onay alındı. FFD500 kanatçık tasarım parametreleriyle FEA modeli çalıştırılıyor...\n✅ ANALİZ TAMAMLANDI. Maks. Von Mises gerilmesi 245 MPa hesaplandı. Tasarım yapısal olarak GÜVENLİDİR.'

    # 4. Sonucu Hub'a Geri Gönderme
    sio.emit('agent_response', {
        'agent': AGENT_NAME,
        'text': result_text,
        'channel': channel
    })
    
    # Eski sistem uyumluluğu için response
    sio.emit('result', { 'agent': AGENT_NAME, 'text': result_text })
    sio.emit('message', { 'agent': AGENT_NAME, 'text': result_text })
    print(f"[INFO] Yanıt Hub'a iletildi:\n{result_text}")

# Eski Hub Yayınlarını Dinlemek İçin:
@sio.on('broadcast_task')
def on_broadcast(data):
    handle_agent_task(data)

@sio.on('message')
def on_message(data):
    handle_agent_task(data)

@sio.on('task_assignment')
def on_assignment(data):
    handle_agent_task(data)

@sio.event
def disconnect():
    global is_connected
    is_connected = False
    print("[INFO] Hub bağlantısı kesildi.")

# 5. Heartbeat (Sağlık Sinyali) Gönderim Döngüsü (Her 5 saniyede bir)
def heartbeat_loop():
    while True:
        if is_connected:
            try:
                sio.emit('ping_heartbeat', {
                    'name': AGENT_NAME,
                    'role': AGENT_ROLE,
                    'model': AGENT_MODEL
                })
            except Exception as e:
                pass
        time.sleep(5)

# Heartbeat döngüsünü arka planda başlat
t = threading.Thread(target=heartbeat_loop, daemon=True)
t.start()

# Hub'a bağlan ve açık tut
if __name__ == "__main__":
    try:
        print(f"Bağlanılacak Hub: {HUB_URL}")
        # Bağlantıda SSL doğrulaması vb. sorunlar olmaması için (gerekiyorsa) ayar yapılabilir:
        sio.connect(HUB_URL, transports=['websocket', 'polling'])
        sio.wait()
    except KeyboardInterrupt:
        print("\nAjan kapatılıyor.")
    except Exception as e:
        print(f"Bağlantı hatası: {e}")
