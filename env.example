# Multicopter Projesi - AI Orkestra Yapılandırma Şablonu
# Bu dosyayı .env olarak kopyalayın ve alanları doldurun.
# DİKKAT: .env dosyasını ASLA GitHub'a göndermeyin (.gitignore'da olmalı).

# --- GİTHUB KİMLİK DOĞRULAMA ---
# Yöntem 1: SSH Anahtarı (Önerilen)
# Özel anahtarınızın tam içeriğini buraya yapıştırın (-----BEGIN... ile başlayıp ...END----- ile biten kısım)
# Not: Satır sonlarını \n olarak bırakın
GITHUB_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\nBURAYA_KENDI_OZEL_ANAHTARINIZI_YAPISTIRIN\n-----END OPENSSH PRIVATE KEY-----"

# Eğer özel anahtarınız bir şifre (passphrase) ile korunuyorsa buraya girin, yoksa boş bırakın.
GITHUB_SSH_PASSPHRASE=""

# Yöntem 2: Personal Access Token (Alternatif)
# SSH kullanmak istemiyorsanız, 'repo' yetkisine sahip PAT token'ınızı buraya girin.
GITHUB_TOKEN=""

# --- ORKESTRA AYARLARI ---
# Bu AI ajanının benzersiz kimliği (örn: agent_design, agent_sim, agent_report)
AGENT_ID="agent_01"

# Ajanın rolü (örn: tandem_wing_designer, fire_system_analyst)
AGENT_ROLE="general_worker"

# Çalışılacak Branch Adı (Otomatik oluşturulacak: agent/{AGENT_ID}/{TASK_ID})
TARGET_BRANCH_PREFIX="agent"

# Merkezi Depo Adresi (Değiştirmeyin)
REPO_URL_SSH="git@github.com:aalpay1968-eng/Multicopter.git"
REPO_URL_HTTPS="https://github.com/aalpay1968-eng/Multicopter.git"

# --- PROJE YAPILANDIRMASI ---
# Ana çalışma branch'i
MAIN_BRANCH="main"

# Rapor ve çıktı klasörü
OUTPUT_DIR="reports"

# Log seviyesi (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
